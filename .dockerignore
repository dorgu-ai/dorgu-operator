# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include what a package embeds with //go:embed. The build fails without it ("no matching
# files found"); test/dockerctx fails when an embed target is missing here.
!internal/intake/admission_reference.yaml
